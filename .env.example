# Timetable Scheduler — environment variables
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local to version control (already in .gitignore).

# ── Supabase (required) ──────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Anon/public key — safe to expose, controlled by RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key — NEVER expose to the browser or commit to git.
# Used server-side only for admin DB operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
